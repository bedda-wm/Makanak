# Copy to .env for local development. Never commit real values.

# Signs the Flask session cookie. Required in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-random-64-char-hex-string

# PostgreSQL connection string (production). Leave unset locally to use the
# SQLite file at makanak-api/app.db.
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Comma-separated browser origins allowed to send credentialed requests.
# Not needed in production, where the frontend and API share one origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Path prefix this API is mounted under. "/api" matches the Vercel rewrite.
API_PATH_PREFIX=/api

# Send the session cookie only over HTTPS. Defaults to on when deployed.
SESSION_COOKIE_SECURE=0
